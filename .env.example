# ============================================
# Research Paper Summarizer — Environment Variables
# ============================================
# Copy this file to .env and fill in your keys
# All services are FREE tier

# --- LLM APIs (all free/low cost) ---
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_key_here

# Get from: https://console.groq.com (Groq)
GROQ_API_KEY=your_key_here

# Get from: https://aistudio.google.com/apikey (Google AI Studio)
GOOGLE_AI_API_KEY=your_key_here

# Get from: https://platform.deepseek.com/api_keys (DeepSeek direct API)
DEEPSEEK_API_KEY=your_key_here

# Get from: Cloudflare Dashboard → AI → Workers AI (Cloudflare Workers AI direct)
CLOUDFLARE_API_KEY=your_key_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# --- Email (Gmail SMTP — free, 500/day limit) ---
# Your Gmail address
GMAIL_ADDRESS=alokprasadshriwastava@gmail.com
# Get from: Google Account → Security → 2-Step Verification → App Passwords
GMAIL_APP_PASSWORD=your_16_char_app_password

# --- Supabase (free tier) ---
# Get from: https://supabase.com → create project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# --- Admin ---
ADMIN_EMAIL=alokprasadshriwastava@gmail.com
